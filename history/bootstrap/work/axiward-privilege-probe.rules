# Rule-matching probe only. This file is not installed in Codex configuration.
# The example executable path below is never executed.
prefix_rule(
    pattern = ["C:/axiward-probe/axiward.exe", ["status", "next", "search", "prepare", "submit", "cancel"]],
    decision = "allow",
    justification = "Allow only the agent-facing Axiward entry points.",
)

prefix_rule(
    pattern = ["C:/axiward-probe/axiward.exe", "view", "add"],
    decision = "allow",
    justification = "Allow controlled material export into the task view.",
)

prefix_rule(
    pattern = ["C:/axiward-probe/axiward.exe", "decide"],
    decision = "forbidden",
    justification = "User decisions must use the separate human entry point.",
)
